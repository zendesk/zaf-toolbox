{
    "name": "@zendesk/zaf-toolbox",
    "version": "1.10.9",
    "description": "A toolbox for ZAF application built with 🩷 by Zendesk Labs",
    "main": "lib/src/index.js",
    "types": "lib/src/index.d.ts",
    "scripts": {
        "build": "gulp build",
        "lint": "eslint . --max-warnings 0",
        "lint:fix": "eslint src __tests__ --fix",
        "test": "jest --coverage",
        "test:ci": "jest --coverage --ci --runInBand --verbose",
        "prettier": "prettier --check .",
        "prettier:fix-all": "prettier --write .",
        "prettier:fix": "prettier --write $1",
        "prepare": "npm run build"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/zendesk/zaf-toolbox.git"
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com"
    },
    "author": "Zendesk-Labs",
    "license": "Apache-2.0",
    "files": [
        "lib/**",
        "!**/*.tsbuildinfo",
        "README.md"
    ],
    "_moduleAliases": {
        "@models": "lib/models",
        "@services": "lib/services",
        "@utils": "lib/utils",
        "@errors": "lib/errors"
    },
    "peerDependencies": {
        "react": "^16.14.0 || ^17.0.0 || ^18.0.0",
        "react-dom": "^16.14.0 || ^17.0.0 || ^18.0.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@testing-library/jest-dom": "^7.0.0",
        "@types/gulp": "^4.0.18",
        "@types/jest": "^30.0.0",
        "@types/node": "^26.1.1",
        "@types/react": "^19.2.16",
        "@typescript-eslint/parser": "^8.64.0",
        "del": "^8.0.1",
        "eslint": "^10.8.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jest": "^29.16.0",
        "eslint-plugin-jsdoc": "^63.3.1",
        "eslint-plugin-prettier": "^5.5.6",
        "globals": "^17.7.0",
        "gulp": "^5.0.1",
        "jest": "^30.2.0",
        "jest-environment-jsdom": "^30.2.0",
        "prettier": "^3.9.6",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "ts-jest": "^29.4.11",
        "ts-node": "^10.9.1",
        "tsc-alias": "^1.8.17",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.63.0"
    }
}
